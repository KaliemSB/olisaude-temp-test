generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Sex {
  male
  female
}

model Client {
  id                   String                @id @unique @default(uuid())
  name                 String
  birthDate            DateTime              @map("birth_date")
  sex                  Sex
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  clientHealthProblems ClientHealthProblem[]

  @@map("clients")
}

model ClientHealthProblem {
  client        Client        @relation(fields: [clientId], references: [id])
  clientId      String        @map("client_id")
  healthProblem HealthProblem @relation(fields: [problemId], references: [id])
  problemId     String        @map("problem_id")

  @@id([clientId, problemId])
  @@map("clients_health_problems")
}

model HealthProblem {
  id                   String                @id @unique @default(uuid())
  name                 String
  severity             Int
  clientHealthProblems ClientHealthProblem[]

  @@map("health_problems")
}
