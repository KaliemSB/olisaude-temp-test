generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Sex {
  male
  female
}

model Client {
  id        String   @id @unique @default(uuid())
  name      String
  birthDate DateTime @map("birth_date")
  sex       Sex
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clients")
}

model ClientHealthProblem {
  clientId  String
  problemId String

  @@id([clientId, problemId])
  @@map("clients_health_problems")
}

model HealthProblem {
  id       String @id @unique @default(uuid())
  name     String
  severity Int

  @@map("health_problems")
}
